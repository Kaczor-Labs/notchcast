        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchcast가 사용 중이던 앱에 항목을 다시 붙여넣도록 허용합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Notchcast cole itens de volta no app que você estava usando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить Notchcast вставлять объекты обратно в приложение, которым вы пользовались."
