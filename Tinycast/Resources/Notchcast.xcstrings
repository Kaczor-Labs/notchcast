    "Bluetooth did not change state. Check Notchcast’s Bluetooth permission." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth hat den Zustand nicht geändert. Prüfe die Bluetooth-Berechtigung von Notchcast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth no cambió de estado. Revisa el permiso de Bluetooth de Notchcast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’état du Bluetooth n’a pas changé. Vérifiez l’autorisation Bluetooth de Notchcast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetoothの状態が変わりませんでした。NotchcastのBluetoothの許可を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth 상태가 변경되지 않았습니다. Notchcast의 Bluetooth 권한을 확인하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bluetooth não mudou de estado. Verifique a permissão de Bluetooth do Notchcast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Состояние Bluetooth не изменилось. Проверьте разрешение Bluetooth для Notchcast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "蓝牙状态未改变。请检查 Notchcast 的蓝牙权限。"
