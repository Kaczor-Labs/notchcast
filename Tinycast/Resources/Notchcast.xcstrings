    "Allow Notchcast to control Finder in System Settings › Privacy & Security › Automation, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Notchcast in „Systemeinstellungen › Datenschutz & Sicherheit › Automation“, den Finder zu steuern, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Notchcast controle el Finder en Ajustes del Sistema › Privacidad y seguridad › Automatización y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Notchcast à contrôler le Finder dans Réglages Système › Confidentialité et sécurité › Automatisation, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › オートメーションで、NotchcastにFinderの操作を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 자동화에서 Notchcast가 Finder를 제어하도록 허용한 다음 다시 시도하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Notchcast controle o Finder em Ajustes do Sistema › Privacidade e Segurança › Automação e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Notchcast управлять Finder в разделе «Системные настройки» › «Конфиденциальность и безопасность» › «Автоматизация», затем повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”›“隐私与安全性”›“自动化”中允许 Notchcast 控制访达，然后重试。"
          }
        }
      }
    },
    "Allow Notchcast to control the requested app in Automation settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Notchcast in den Automation-Einstellungen, die angeforderte App zu steuern, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Notchcast controle la app solicitada en los ajustes de Automatización y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Notchcast à contrôler l’app demandée dans les réglages d’automatisation, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オートメーション設定で、Notchcastに要求されたAppの操作を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동화 설정에서 Notchcast가 요청한 앱을 제어하도록 허용한 다음 다시 시도하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Notchcast controle o app solicitado nos ajustes de Automação e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Notchcast управлять нужным приложением в настройках автоматизации, затем повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“自动化”设置中允许 Notchcast 控制所请求的 App，然后重试。"
          }
        }
      }
    },
    "Allow Notchcast to control your Mac in Accessibility settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
