    "An app or web page asked Notchcast to run this with “%@”. Allow only links you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine App oder Webseite hat Notchcast gebeten, dies mit „%@“ auszuführen. Erlaube nur Links, denen du vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app o página web ha pedido a Notchcast que ejecute esto con “%@”. Permite solo enlaces de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app ou une page web a demandé à Notchcast d’exécuter ceci avec « %@ ». N’autorisez que les liens de confiance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリまたは Web ページが Notchcast に「%@」でこの実行を求めました。信頼できるリンクだけを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 또는 웹 페이지가 Notchcast에 “%@”(으)로 이 항목의 실행을 요청했습니다. 신뢰할 수 있는 링크만 허용하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um app ou página web pediu ao Notchcast para executar isto com “%@”. Permita apenas links confiáveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение или веб-страница попросили Notchcast выполнить это с «%@». Разрешайте только ссылки, которым доверяете."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某个应用或网页请求 Notchcast 以“%@”运行此项。请只允许你信任的链接。"
          }
        }
      }
    },
    "An app or web page asked Notchcast to run this. Allow only links you trust." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
