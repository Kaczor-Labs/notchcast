{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ doesn't share its text with Notchcast." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ teilt seinen Text nicht mit Notchcast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no comparte su texto con Notchcast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne partage pas son texte avec Notchcast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はテキストをNotchcastと共有しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 텍스트를 Notchcast와 공유하지 않습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não compartilha o texto dele com o Notchcast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не передаёт свой текст в Notchcast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 不会与 Notchcast 共享其文本。"
          }
        }
      }
    },
    "%@: “%@” isn't a shortcut Notchcast can bind" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: „%2$@“ ist kein Kurzbefehl, den Notchcast belegen kann"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: “%2$@” isn't a shortcut Notchcast can bind"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: “%@” no es un atajo que Notchcast pueda asignar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : « %@ » n’est pas un raccourci que Notchcast peut associer"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 「%@」はNotchcastが割り当てられるショートカットではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: “%@”은(는) Notchcast에서 지정할 수 있는 단축키가 아닙니다"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: “%@” não é um atalho que o Notchcast possa associar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: «%@» — не то сочетание клавиш, которое может назначить Notchcast"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：“%@”不是 Notchcast 可以绑定的快捷键"
          }
        }
      }
    },
    "A .tinycast file exported from Notchcast." : {
