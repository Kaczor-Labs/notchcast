    "Let Notchcast paste items back into the app you were using." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Notchcast, Objekte wieder in die zuletzt verwendete App einzusetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que Notchcast pegue elementos de nuevo en la app que estabas usando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Notchcast à coller du contenu dans vos apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchcastが、使用していたAppに項目をペーストできるようにします。"
