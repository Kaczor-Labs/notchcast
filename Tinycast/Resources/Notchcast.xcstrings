    "Notchcast Needs Accessibility Access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notchcast benötigt Zugriff auf Bedienungshilfen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
