# Shared by Notchcast scripts and GitHub Actions. No secrets here.
UPSTREAM_REPO=abue-ammar/tinycast
FORK_REPO=kaczordodgers/notchcast
MAINTAINER_NAME=Damian
MAINTAINER_EMAIL=336236323+kaczordodgers@users.noreply.github.com
TESTED_CONTEXT=notchcast/tested
# Sync moves main onto an upstream commit only with the repo owner's success status of this context on it (ci.py).
REVIEW_CONTEXT=notchcast/upstream-review
# The one open review PR of the upstream diff waiting for that status.
REVIEW_LABEL=upstream-sync
# Releases older than this upstream tag are never mirrored.
BASELINE_TAG=v0.12.6-beta.130
# Our app: built under this name and bundle id (project.yml); the installer migrates data from OLD_BUNDLE_ID once.
APP_NAME=Notchcast
BUNDLE_ID=app.notchcast
OLD_BUNDLE_ID=com.tinycast.app.beta
OLD_APP="/Applications/Tinycast Beta.app"
OLD_CONFIG_DIR=tinycast-beta
SIGN_IDENTITY="Notchcast Self-Signed"
# SHA-1 of the Notchcast Self-Signed leaf certificate (public). CI publishes a release only when signed by it.
# update.sh never reads this: each Mac pins its own SIGN_SHA1 in ~/.config/notchcast/private.env (#872).
RELEASE_SIGN_SHA1=95280FD4EC25303CCC1FE2AA2A5E8B0A1A757DCC
# Harnesses the GitHub-hosted VM cannot run; they still run on a Mac. Vision OCR fails in the VM
# (CRImageReaderError) and so does capturing rendered text. Each must pass locally before being listed.
CI_SKIP_TESTS="ClipboardTextTests FormInputTests"
# Harnesses a self-hosted runner never runs: it is a maintainer's working Mac, and each of these names an API that can
# show a window, take focus, launch an app or reach the pasteboard, sound, events or preferences (ci-tests-test.sh).
SELF_HOSTED_SKIP_TESTS="AppInstallationTests ClipboardFilePerformanceTests ClipboardCoordinatorTests CalloutTests DictationCueTests CommandEscapeTapTests CustomCommandTests DictationFieldTests FormInputTests NotesEditorPerformanceTests EntryIconTests RelaunchTests QuicklinkCoordinatorTests MicrophoneMuteTests NotesEditorTests PaletteMenuClickTests nc-HideCommandM-module-test nc-DisplaySound-module-test PasteboardTests nc-Downloads-webpage-test nc-Island-capture-sharing-test nc-MiddleClick-gesture-test nc-Notchcast-frosted-guard-test nc-Island-palette-surface-test nc-Notchcast-island-buttons-test SnippetsTests nc-Palette-keyboard-contract-test nc-Notchcast-island-audit-render-test nc-ShowDesktop-module-test nc-IPhoneBackup-module-test nc-Notchcast-tap-test nc-QuitProtection-module-test notchcast-addon-notice-queue-test nc-Island-level-readout-test nc-MusicBlock-module-test nc-Notchcast-island-cards-test nc-Notchcast-core-test nc-Notchcast-hud-dialog-surface-test"
# Harnesses of features Notchcast hides (docs/hidden.md#harnesses): no CI, land or local suite runs them;
# naming one runs it (./Scripts/run-tests.sh ExtensionTests). Their code and upstream sync stay.
HIDDEN_TESTS="AppleShortcutTests CloudSyncTests ExtensionAccessoryTests ExtensionCleanupTests ExtensionFormTests ExtensionIconTests ExtensionImageSizeTests ExtensionMetadataTests ExtensionRefreshTests ExtensionSignInTests ExtensionStoreTests ExtensionTests ExtensionVersionTests SymbolsTests"
# Our fork of enmerasoftware/ai-design-check (Title Case for macOS commands and buttons in Swift), run by
# notchcast/design-check.sh; an npm spec pinned to a tag, bump on purpose.
DESIGN_CHECK_SPEC=github:kaczordodgers/ai-design-check#v0.16.3-fork.1
JSCPD_VERSION=4.0.5
