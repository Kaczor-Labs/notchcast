# Shared by Notchcast scripts and GitHub Actions. No secrets here.
UPSTREAM_REPO=abue-ammar/tinycast
FORK_REPO=kaczordodgers/notchcast
MAINTAINER_NAME=Damian
MAINTAINER_EMAIL=336236323+kaczordodgers@users.noreply.github.com
TESTED_CONTEXT=notchcast/tested
# land.sh --guard's verdict on a commit landed from Linux, once the macOS suite ran on main: success or failure.
FOLLOWUP_CONTEXT=notchcast/mac-follow-up
# Sync moves main onto an upstream commit only with the repo owner's success status of this context on it (ci.py).
REVIEW_CONTEXT=notchcast/upstream-review
# The one open review PR of the upstream diff waiting for that status.
REVIEW_LABEL=upstream-sync
# Releases older than this upstream tag are never mirrored.
BASELINE_TAG=v0.12.6-beta.130
# Our app: built under this name and bundle id (project.yml); the installer migrates data from OLD_BUNDLE_ID once.
APP_NAME=Notchcast
BUNDLE_ID=app.notchcast
OLD_BUNDLE_ID=com.tinycast.app.beta
OLD_APP="/Applications/Tinycast Beta.app"
OLD_CONFIG_DIR=tinycast-beta
SIGN_IDENTITY="Notchcast Self-Signed"
# SHA-1 of the Notchcast Self-Signed leaf certificate (public). CI publishes a release only when signed by it.
# update.sh never reads this: each Mac pins its own SIGN_SHA1 in ~/.config/notchcast/private.env (#872).
RELEASE_SIGN_SHA1=95280FD4EC25303CCC1FE2AA2A5E8B0A1A757DCC
# How many PRs train.sh --queue stacks into one landing batch.
LAND_BATCH_SIZE=5
# train.sh --queue takes no batch until the newest sign-off is this old, so PRs signed off together ride one train.
LAND_SETTLE_SECONDS=120
# Harnesses the GitHub-hosted VM cannot run; they still run on a Mac. Vision OCR fails in the VM
# (CRImageReaderError). Each must pass locally before being listed.
CI_SKIP_TESTS="ClipboardTextTests"
# Hosted-only harnesses: each names an API that can show a window, take focus, launch an app or reach the keychain,
# pasteboard, sound, events or preferences (ci-tests-test.sh), so it runs only on a GitHub-hosted VM or an isolated
# runner, never on a working Mac: test-harnesses.sh skips it there and refuses a run that names it (#1036).
HOSTED_ONLY_TESTS="MCPOAuthTests AppInstallationTests ClipboardFilePerformanceTests ClipboardCoordinatorTests CalloutTests DictationCueTests CommandEscapeTapTests CustomCommandTests DictationFieldTests FormInputTests NotesEditorPerformanceTests EntryIconTests RelaunchTests QuicklinkCoordinatorTests MicrophoneMuteTests NotesEditorTests PaletteMenuClickTests PasteboardTests SnippetsTests"
# The toolchain an isolated runner's proof must carry (pr.yml's stamp: xcodebuild -version, then sw_vers), set from a
# run compared with a hosted run of the same commit; land.sh refuses any other.
ISOLATED_TOOLCHAIN="Xcode 27.2 Build version 27B52 ProductName: macOS ProductVersion: 27.2.1 BuildVersion: 26B131"
# Harnesses of features Notchcast hides (docs/hidden.md#harnesses): no CI, land or local suite runs them;
# naming one runs it (./Scripts/run-tests.sh ExtensionTests). Their code and upstream sync stay.
HIDDEN_TESTS="AppleShortcutTests CloudSyncTests ExtensionAccessoryTests ExtensionCleanupTests ExtensionFormTests ExtensionIconTests ExtensionImageSizeTests ExtensionMetadataTests ExtensionRefreshTests ExtensionSignInTests ExtensionStoreTests ExtensionTests ExtensionVersionTests FallbackTests MenuSearchTests NotesEditorPerformanceTests NotesEditorTests NotesTests SupportTests SymbolsTests WindowSwitchTests"
# Our fork of enmerasoftware/ai-design-check (Title Case for macOS commands and buttons in Swift), run by
# notchcast/design-check.sh: the tarball of tag v0.16.3-fork.1's commit (npm 10 can't run a commit spec).
DESIGN_CHECK_SPEC=https://codeload.github.com/kaczordodgers/ai-design-check/tar.gz/250540eafbee65a7b76107317a0c7e70d563a686
# Only for landing: land.sh runs main's check-drift.py on the merged tree, and that one still reads this key.
JSCPD_VERSION=4.0.5
# Harnesses that compile and pass on Linux (swift-corelibs-foundation, no Apple framework); every other harness is
# mac-only. Scripts/run-tests.sh runs only these on Linux, and land.sh lands from Linux only when each harness a diff
# reaches is listed. A name is added after it passed on Linux and on a Mac (notchcast/README.md, "Linux").
LINUX_OK_TESTS="ActionMenuSearchTests AppleShortcutTests ExtensionImageSizeTests ExtensionVersionTests FavoritesTests PaletteSelectionTests PaletteShortcutTests RedactionTests SettingsBackupTests SupportTests SyntaxHighlightTests TextDiffTests VolumeTests WindowSwitchTests"
# Harness inputs (paths, fnmatch globs) whose Foundation behaviour differs between Linux and macOS: a diff touching
# one never lands from Linux. An auto-revert of a Linux landing adds its cause.
LINUX_DENY_INPUTS="Tinycast/Platform/AppDisplayName.swift Tinycast/Platform/BundleLocalization.swift"
# Fork harnesses tag themselves (harness-tags.sh); an installed tools copy has no lists to fill.
harness_tags="$(dirname "${BASH_SOURCE[0]:-$0}")/harness-tags.sh"
[ ! -f "$harness_tags" ] || source "$harness_tags"
unset harness_tags
