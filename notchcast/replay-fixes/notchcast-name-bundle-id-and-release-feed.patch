diff --git a/project.yml b/project.yml
index 98cab7d29..ae0e99baf 100644
--- a/project.yml
+++ b/project.yml
@@ -17,18 +17,20 @@ settings:
     # A stable self-signed identity keeps the Accessibility grant across rebuilds. docs/signing.md
     CODE_SIGN_IDENTITY: "Tinycast Self-Signed"
     SWIFT_STRICT_CONCURRENCY: complete
-    TINYCAST_BUNDLE_IDENTIFIER: com.abueammar.tinycast
-    TINYCAST_URL_SCHEME: tinycast
+    TINYCAST_BUNDLE_IDENTIFIER: app.notchcast
+    TINYCAST_URL_SCHEME: notchcast
     # iCloud needs a profile, so only a build that names one swaps in TinycastCloud.entitlements.
     TINYCAST_ENTITLEMENTS: Tinycast/Tinycast.entitlements
     TINYCAST_PROVISIONING_PROFILE: ""
   configs:
     Debug:
-      TINYCAST_BUNDLE_IDENTIFIER: com.abueammar.tinycast.dev
+      TINYCAST_BUNDLE_IDENTIFIER: app.notchcast.dev
       TINYCAST_CLOUDKIT_ENVIRONMENT: Development
       TINYCAST_APS_ENVIRONMENT: development
       # Its own scheme too, so a link never lands in whichever channel macOS happens to pick.
-      TINYCAST_URL_SCHEME: tinycast-dev
+      TINYCAST_URL_SCHEME: notchcast-dev
+      # Ad-hoc, so headless Xcode builds without a local identity; releases pass their own.
+      CODE_SIGN_IDENTITY: "-"
       DICTATION_EXECUTABLE_NAME: Tinycast Dev Dictation
     Release:
       DICTATION_EXECUTABLE_NAME: Tinycast Dictation
@@ -46,6 +48,7 @@ targets:
   Tinycast:
     type: application
     platform: macOS
+    scheme: {}
     sources:
       - path: Tinycast
         # Helper-only sources: compiling them in would link Vision and PDFKit into the app.
@@ -106,7 +109,9 @@ targets:
       configs:
         # Debug is its own channel, so a local build never corrupts the installed app's state.
         Debug:
-          PRODUCT_NAME: Tinycast Dev
+          PRODUCT_NAME: Notchcast Dev
+        Release:
+          PRODUCT_NAME: Notchcast
 
   ClipboardTextHelper:
     type: tool
