diff --git a/project.yml b/project.yml
index b4d6b28ab..f691b552c 100644
--- a/project.yml
+++ b/project.yml
@@ -31,9 +31,9 @@ settings:
       TINYCAST_URL_SCHEME: notchcast-dev
       # Ad-hoc, so headless Xcode builds without a local identity; releases pass their own.
       CODE_SIGN_IDENTITY: "-"
-      DICTATION_EXECUTABLE_NAME: Tinycast Dev Dictation
+      DICTATION_EXECUTABLE_NAME: Notchcast Dev Dictation
     Release:
-      DICTATION_EXECUTABLE_NAME: Tinycast Dictation
+      DICTATION_EXECUTABLE_NAME: Notchcast Dictation
       TINYCAST_CLOUDKIT_ENVIRONMENT: Production
       TINYCAST_APS_ENVIRONMENT: production
       # Release-only: library validation refuses Debug's `.debug.dylib`, whose team never matches.
@@ -103,6 +103,18 @@ targets:
         copy:
           destination: wrapper
           subpath: Contents/Helpers
+    postBuildScripts:
+      - name: Notchcast name override
+        script: python3 "$SRCROOT/notchcast/name-override.py"
+        inputFiles:
+          - $(SRCROOT)/notchcast/name-override.py
+          - $(SRCROOT)/Tinycast/Info.plist
+          - $(SRCROOT)/Tinycast/Resources/Localizable.xcstrings
+          - $(SRCROOT)/Tinycast/Resources/InfoPlist.xcstrings
+          # Orders the phase after Xcode writes Info.plist, which it otherwise does last.
+          - $(TARGET_BUILD_DIR)/$(INFOPLIST_PATH)
+        outputFiles:
+          - $(DERIVED_FILE_DIR)/name-override.stamp
     settings:
       base:
         PRODUCT_BUNDLE_IDENTIFIER: "$(TINYCAST_BUNDLE_IDENTIFIER)"
